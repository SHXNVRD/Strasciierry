<Page x:Class="Strasciierry.UI.Views.AsciiArtPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkitControls="using:CommunityToolkit.WinUI.Controls"
      xmlns:asciiCanvas="using:Strasciierry.UI.Controls.AsciiCanvas"
      xmlns:characterPalette="using:Strasciierry.UI.Controls.CharacterPalette"
      xmlns:controls="using:Strasciierry.UI.Controls"
      xmlns:converters="using:Strasciierry.UI.Converters"
      xmlns:toolkitConverters="using:CommunityToolkit.WinUI.Converters"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <converters:PercentageDisplayConverter x:Key="PercentageDisplayConverter" />
            <converters:FactorConverter x:Key="FactorConverter" />
            <converters:WindowsUiColorToBrushConverter x:Key="WindowsUiColorToBrushConverter" />
            <converters:SystemDrawingColorToWindowsUiColorConverter x:Key="SystemDrawingColorToWindowsUiColorConverter" />
            <converters:StringToFontFamilyConverter x:Key="StringToFontFamilyConverter" />
            <converters:FontStyleToFontWeightConverter x:Key="FontStyleToFontWeightConverter" />
            <converters:SystemDrawingFontStyleToWindowsUiFontStyleConverter x:Key="SystemDrawingFontStyleToWindowsUiFontStyleConverter" />
            <converters:FontStyleToTextDecorationsConverter x:Key="FontStyleToTextDecorationsConverter" />
            <converters:DrawingToolToBooleanConverter x:Key="DrawingToolToBooleanConverter" />
            <toolkitConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Flyout x:Key="FlyoutBackgroundColorPicker">
                <ColorPicker x:Name="BackgroundColorPicker"
                             IsColorChannelTextInputVisible="False"
                             IsColorPreviewVisible="False"
                             IsAlphaEnabled="True"
                             IsAlphaTextInputVisible="False"
                             IsAlphaSliderVisible="True"
                             IsHexInputVisible="True"
                             Color="{x:Bind ViewModel.ArtBackground, Converter={StaticResource SystemDrawingColorToWindowsUiColorConverter}, Mode=TwoWay}" />
            </Flyout>
            <Flyout x:Key="FlyoutForegroundColorPicker">
                <ColorPicker x:Name="ForegroundColorPicker"
                             IsColorChannelTextInputVisible="False"
                             IsColorPreviewVisible="False"
                             IsAlphaEnabled="True"
                             IsAlphaTextInputVisible="False"
                             IsAlphaSliderVisible="True"
                             IsHexInputVisible="True"
                             Color="{x:Bind ViewModel.ArtForeground, Converter={StaticResource SystemDrawingColorToWindowsUiColorConverter}, Mode=TwoWay}" />
            </Flyout>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель  инcтрументов -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="4">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <MenuBar Margin="5 0 0 0">
                    <MenuBarItem x:Uid="Menu_File">
                        <MenuFlyoutItem x:Uid="Menu_File_Open"
                                        Command="{x:Bind OpenFileCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control"
                                                     Key="O" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Menu_File_Save"
                                        Command="{x:Bind SaveFileCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control"
                                                     Key="S" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>
                <Button x:Uid="AsciiArtPageSettingsButton"
                        Command="{x:Bind ShowSettingsWindowCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Левая панель  инcтрументов -->
        <Grid Grid.Column="0"
              Grid.Row="1"
              CornerRadius="5"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Center"
              Margin="{StaticResource XSmallLeftTopRightBottomMargin}">

            <characterPalette:CharacterPalette x:Name="CharacterPalette"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" />
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                Background="{StaticResource ControlFillColorDefault}"
                CornerRadius="5">

            <!--
            <Grid>


                <Border CornerRadius="5"
                        Background="{Binding ElementName=BackgroundColorPicker, Path=Color, Converter={StaticResource WindowsUiColorToBrushConverter}}">
                    <ScrollViewer Style="{StaticResource ScrollViewerStyle}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  x:Name="ContentScrollViewer">
                        <TextBlock x:Name="ArtTextBlock"
                                   Text="{x:Bind ViewModel.SymbolicArt, Mode=OneWay}"
                                   Foreground="{Binding ElementName=ForegroundColorPicker, Path=Color, Converter={StaticResource WindowsUiColorToBrushConverter}}"
                                   TextWrapping="WrapWholeWords"
                                   FontFamily="{x:Bind ViewModel.FontName, Converter={StaticResource StringToFontFamilyConverter}, Mode=TwoWay}"
                                   IsTextSelectionEnabled="True"
                                   FontSize="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                                   TextDecorations="{x:Bind ViewModel.TextDecorations, Converter={StaticResource FontStyleToTextDecorationsConverter}, Mode=TwoWay}"
                                   FontWeight="{x:Bind ViewModel.FontWeight, Converter={StaticResource FontStyleToFontWeightConverter}, Mode=TwoWay}"
                                   FontStyle="{x:Bind ViewModel.FontStyle, Converter={StaticResource SystemDrawingFontStyleToWindowsUiFontStyleConverter}, Mode=TwoWay}">
                        </TextBlock>
                    </ScrollViewer>
                </Border>
            </Grid>
                -->
            <asciiCanvas:AsciiCanvas x:Name="AsciiCanvas"
                                     Rows="{x:Bind ViewModel.Rows, Mode=OneWay}"
                                     Columns="{x:Bind ViewModel.Columns, Mode=OneWay}"
                                     GraphicTool="{x:Bind ViewModel.GraphicTool, Mode=OneWay}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     DrawingChar="{x:Bind ViewModel.SelectedItem.Character, Mode=OneWay}"
                                     DrawingForeground="{Binding ElementName=CharacterPalette, Path=SelectedItem.Foreground, Mode=OneWay}"
                                     DrawingBackground="{Binding ElementName=CharacterPalette, Path=SelectedItem.Background, Mode=OneWay}"
                                     DrawingFontFamily="{Binding ElementName=CharacterPalette, Path=SelectedItem.FontFamily, Mode=OneWay}"
                                     DrawingFontStyle="{Binding ElementName=CharacterPalette, Path=SelectedItem.FontStyle, Mode=OneWay}"
                                     ItemsSource="{x:Bind ViewModel.Cells, Mode=OneWay}" />
        </Border>

        <Grid  Grid.Column="2"
               Grid.Row="1"
               Margin="{StaticResource XSmallTopBottomMargin}">

            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Spacing="5"
                        CornerRadius="4"
                        Background="{StaticResource ControlFillColorDefault}">

                <RadioButton Style="{StaticResource LikeToggleButtonStyle}"
                             IsChecked="{x:Bind ViewModel.GraphicTool, Converter={StaticResource DrawingToolToBooleanConverter}, ConverterParameter=Pencil, Mode=TwoWay}">

                    <FontIcon Glyph="&#xE70F;" />

                    <ToggleButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" />
                    </ToggleButton.KeyboardAccelerators>
                </RadioButton>

                <RadioButton Style="{StaticResource LikeToggleButtonStyle}"
                             IsChecked="{x:Bind ViewModel.GraphicTool, Converter={StaticResource DrawingToolToBooleanConverter}, ConverterParameter=Eraser, Mode=TwoWay}">

                    <FontIcon Glyph="&#xE75C;" />

                    <ToggleButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" />
                    </ToggleButton.KeyboardAccelerators>
                </RadioButton>

                <RadioButton Style="{StaticResource LikeToggleButtonStyle}"
                             IsChecked="{x:Bind ViewModel.GraphicTool, Converter={StaticResource DrawingToolToBooleanConverter}, ConverterParameter=Pipette, Mode=TwoWay}">

                    <FontIcon Glyph="&#xEF3C;" />

                    <ToggleButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="I" />
                    </ToggleButton.KeyboardAccelerators>
                </RadioButton>

                <RadioButton Style="{StaticResource LikeToggleButtonStyle}"
                             IsChecked="{x:Bind ViewModel.GraphicTool, Converter={StaticResource DrawingToolToBooleanConverter}, ConverterParameter=Selection, Mode=TwoWay}">

                    <FontIcon Glyph="&#xE739;" />

                    <RadioButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" />
                    </RadioButton.KeyboardAccelerators>
                </RadioButton>

            </StackPanel>

            <ToggleButton x:Name="SwitchArtFromImage"
                          VerticalAlignment="Bottom"
                          Background="{StaticResource ControlFillColorDefault}"
                          Style="{StaticResource TransperantToggleButtonStyle}">

                <FontIcon Glyph="&#xEB9F;" />
            </ToggleButton>
        </Grid>

        <StackPanel Visibility="{Binding ElementName=SwitchArtFromImage, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                    Grid.Column="3"
                    Grid.Row="1"
                    Orientation="Vertical"
                    Margin="{StaticResource XSmallLeftTopMargin}"
                    Spacing="5">

            <Image Stretch="UniformToFill"
                   x:Name="PreviewSourceImage"
                   Width="250"
                   Height="250" />

            <toolkitControls:SettingsCard x:Uid="Converting_Settings_ArtSize"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">

                <Slider x:Name="SizeSlider"
                        IsThumbToolTipEnabled="True"
                        ThumbToolTipValueConverter="{StaticResource PercentageDisplayConverter}"
                        Maximum="100"
                        Minimum="10"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.SizePercent, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        Width="300">

                </Slider>
            </toolkitControls:SettingsCard>

            <toolkitControls:SettingsCard x:Uid="Converting_Settings_HeightReductionFactor"
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalAlignment="Stretch">

                <Slider x:Name="HeightReductionFactorSlider"
                        HorizontalAlignment="Stretch"
                        ThumbToolTipValueConverter="{StaticResource FactorConverter}"
                        Maximum="10"
                        Minimum="1"
                        StepFrequency="0.1"
                        Value="{x:Bind ViewModel.HeightReductionFactor, Mode=TwoWay}"
                        Width="300">
                </Slider>
            </toolkitControls:SettingsCard>

            <toolkitControls:SettingsCard x:Uid="Converting_Settings_Inversion">
                <toolkitControls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardWrapThreshold">200</x:Double>
                </toolkitControls:SettingsCard.Resources>

                <ToggleSwitch HorizontalAlignment="Right"
                              IsOn="{x:Bind ViewModel.IsNegative, Mode=TwoWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="Converting_Settings_Inversion_ToolTip" />
                    </ToolTipService.ToolTip>
                </ToggleSwitch>
            </toolkitControls:SettingsCard>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Uid="Converting_Settings_Background"
                           Margin="0 0 5 0"
                           Grid.Column="0"
                           VerticalAlignment="Center" />
                <Button Background="{Binding ElementName=BackgroundColorPicker, Path=Color, Converter={StaticResource WindowsUiColorToBrushConverter}}"
                        Style="{StaticResource ColorSelectorButtonStyle}"
                        Height="40"
                        Width="40"
                        Grid.Column="1"
                        Flyout="{StaticResource FlyoutBackgroundColorPicker}">
                </Button>

                <TextBlock x:Uid="Converting_Settings_Foreground"
                           Margin="0 0 5 0"
                           Grid.Column="2"
                           VerticalAlignment="Center" />
                <Button Background="{Binding ElementName=ForegroundColorPicker, Path=Color, Converter={StaticResource WindowsUiColorToBrushConverter}}"
                        Style="{StaticResource ColorSelectorButtonStyle}"
                        Height="40"
                        Width="40"
                        Grid.Column="3"
                        Flyout="{StaticResource FlyoutForegroundColorPicker}">
                </Button>
            </Grid>

            <Button HorizontalAlignment="Stretch"
                    x:Uid="Converting_Settings_Generate"
                    Command="{x:Bind ViewModel.GenerateArtCommand}"
                    Margin="0 0 5 0"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- Панель статуса -->
        <Grid HorizontalAlignment="Stretch"
              Margin="{StaticResource XSmallLeftMargin}"
              Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="4"
              Height="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="{StaticResource XSmallRightMargin}">
                <TextBlock x:Uid="Converting_StatusBar_FileName" />
                <TextBlock x:Name="FilePathTextBlock"
                           Margin="{StaticResource XXSmallLeftMargin}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock x:Uid="Converting_StatusBar_ArtRows"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{x:Bind ViewModel.Rows, Mode=OneWay}"
                           Margin="{StaticResource XXSmallLeftMargin}"
                           HorizontalAlignment="Right" />
                <TextBlock x:Uid="Converting_StatusBar_ArtColumns"
                           Margin="{StaticResource SmallLeftMargin}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{x:Bind ViewModel.Columns, Mode=OneWay}"
                           Margin="{StaticResource XXSmallLeftMargin}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
