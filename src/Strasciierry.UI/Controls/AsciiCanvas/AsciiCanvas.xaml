<?xml version="1.0" encoding="utf-8"?>
<controlBase:UserControlBase x:Class="Strasciierry.UI.Controls.AsciiCanvas.AsciiCanvas"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:local="using:Strasciierry.UI.Controls.AsciiCanvas"
                             xmlns:controlBase="using:Strasciierry.UI.Controls"
                             xmlns:converters="using:Strasciierry.UI.Converters"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d">

    <controlBase:UserControlBase.Resources>
        <converters:FontStyleToTextDecorationsConverter x:Key="FontStyleToTextDecorationsConverter" />
        <converters:SystemDrawingColorToBrushConverter x:Key="ColorToBrushConverter" />
        <converters:FontStyleToFontWeightConverter x:Key="FontStyleToFontWeightConverter" />
        <converters:SystemDrawingFontStyleToWindowsUiFontStyleConverter x:Key="FontStyleToFontStyleConverter" />

        <Style TargetType="ContentControl"
               x:Key="CellContentStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                Background="{Binding Background, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity"
                                                    Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid>
                                <ContentPresenter x:Name="Presenter" />

                                <Border x:Name="HoverBorder"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controlBase:UserControlBase.Resources>

    <ScrollView ZoomMode="Enabled"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.Resources>
                <MenuFlyout x:Name="CanvasActionMenu">
                    <MenuFlyoutItem x:Uid="AsciiCanvasActionMenuCopyAction"
                                    Click="OnCopyClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="C" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="AsciiCanvasActionMenuPasteAction"
                                    Click="OnPasteClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE77F;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="V" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="AsciiCanvasActionMenuCutAction"
                                    Click="OnCutClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C6;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="X" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                </MenuFlyout>
            </Grid.Resources>

            <ItemsRepeater x:Name="CanvasRepeater"
                           ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                           VirtualizingStackPanel.VirtualizationMode="Recycling"
                           CacheMode="BitmapCache"
                           FlyoutBase.AttachedFlyout="{x:Bind CanvasActionMenu, Mode=OneWay}"
                           FlowDirection="LeftToRight"
                           RightTapped="CanvasRepeater_RightTapped">

                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="None"
                                       MaximumRowsOrColumns="{x:Bind Columns, Mode=OneWay}"
                                       MinItemHeight="19"
                                       MinItemWidth="10"
                                       MinColumnSpacing="0"
                                       MinRowSpacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:AsciiCanvasCell">
                        <ContentControl Style="{StaticResource CellContentStyle}"
                                        DataContext="{x:Bind}"
                                        PointerPressed="OnCellPointerPressed"
                                        PointerEntered="OnCellPointerEntered"
                                        PointerExited="OnCellPointerExited"
                                        Background="{x:Bind Background, Converter={StaticResource ColorToBrushConverter}, Mode=OneWay}">

                            <TextBlock Text="{x:Bind Symbol, Mode=OneWay}"
                                       FontFamily="{x:Bind FontFamily.Name, Mode=OneWay}"
                                       Foreground="{x:Bind Foreground, Converter={StaticResource ColorToBrushConverter},Mode=OneWay}"
                                       TextDecorations="{x:Bind FontStyle, Converter={StaticResource FontStyleToTextDecorationsConverter}, Mode=OneWay}"
                                       FontStyle="{x:Bind FontStyle, Converter={StaticResource FontStyleToFontStyleConverter}, Mode=OneWay}"
                                       FontWeight="{x:Bind FontStyle, Converter={StaticResource FontStyleToFontWeightConverter}, Mode=OneWay}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </ContentControl>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Canvas x:Name="SelectionLayer"
                    IsHitTestVisible="False" />
        </Grid>
    </ScrollView>
</controlBase:UserControlBase>